{
  "expo": {
    "name": "\u0627\u0644\u0646\u0638\u0627\u0645 \u0627\u0644\u0630\u0643\u064a",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartsystem",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobilerebuild.iau31a",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Record where each sale and visit happens",
        "NSPhotoLibraryUsageDescription": "Choose your company logo for invoices"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.mobilerebuild.iau31a",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Record where each sale and visit happens"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your company logo for invoices"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    }
  }
}